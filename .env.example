# ==============================================================================
# PROGANADO S.A.S. — Plantilla de Variables de Entorno (.env.example)
# Copia este archivo a .env y asigna los valores correspondientes.
# NUNCA subas archivos .env con credenciales reales a GitHub.
# ==============================================================================

# ENTORNO DE EJECUCIÓN
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS LOCAL (DOCKER / POSTGRESQL 16)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/proganado
DATABASE_CLIENT=postgresql

# ------------------------------------------------------------------------------
# 2. SUPABASE CLOUD (POSTGRESQL GESTIONADO EN LA NUBE - 0 COP)
# ------------------------------------------------------------------------------
# Obtén estas claves en tu panel de Supabase: Project Settings -> API
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica-para-el-frontend
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-privada-para-backend-api

# ------------------------------------------------------------------------------
# 3. SEGURIDAD Y AUTENTICACIÓN
# ------------------------------------------------------------------------------
JWT_SECRET=tu-secreto-jwt-aleatorio-minimo-32-caracteres-para-produccion
SESSION_SECRET=tu-secreto-para-cookies-http-only

# ------------------------------------------------------------------------------
# 4. NOTIFICACIONES (RESEND / EMAIL TRANSACCIONAL - FREE TIER 3K/MES)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_tu_api_key_de_resend
EMAIL_FROM=alertas@proganado.co
