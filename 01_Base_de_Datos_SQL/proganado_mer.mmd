        boolean es_alta_produccion_16l "Umbral 16L"
        boolean apta_para_venta
        string motivo_no_apta "Cinta Roja o Calostro"
    }

    ACOPIO_COLANTA {
        int id_acopio PK
        int fk_hacienda FK
        date fecha_recogida
        string numero_tiquete_colanta UK
        decimal litros_reportados_tiquete
        decimal litros_calculados_sistema
        decimal diferencia_merma_litros
        decimal total_liquidacion_cop
    }

    EVENTO_REPRODUCTIVO {
        int id_evento PK
        int fk_vaca FK
        int fk_toro_pajilla FK
        string tipo_evento "ADE_Dia30 o Parche_Dia50 o Celo o IA o Monta o Palpacion o Secado210d o Parto"
        date fecha_evento
        int numero_servicio_en_lactancia
        int dias_abiertos_al_evento "Alerta dia 90 max 100d"
    }

    TRATAMIENTO_SANITARIO {
        int id_tratamiento PK
        int fk_bovino FK
        int fk_farmaco FK
        date fecha_aplicacion
        decimal dosis_ml
        date fecha_fin_retiro_leche
        boolean tiene_cinta_roja_activa "Cinta Roja Pata"
        boolean ordeno_en_balde_descarte
