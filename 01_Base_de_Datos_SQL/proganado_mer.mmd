    HACIENDA_PREDIO {
        int id_hacienda PK
        string nombre_hacienda
        string codigo_predio_ica UK
        int capacidad_maxima_animales "210 cabezas"
        string municipio "Santa Rosa de Osos"
    }

    POTRERO {
        int id_potrero PK
        int fk_hacienda FK
        int numero_potrero
        string nombre_potrero
        string tipo_pasto "Kikuyo"
        int capacidad_maxima_cabezas
        string estado_potrero "Voisin"
    }

    BOVINO {
        int id_bovino PK
        string nombre
        char sexo "H o M"
        date fecha_nacimiento
        string estado_vital "Vivo o Muerto"
        string estado_productivo "Lactancia o Seca"
        string categoria_reproductiva "Excelente o Buena o Regular"
        int fk_raza FK
        int fk_potrero_actual FK
        int fk_padre FK
        int fk_madre FK
    }

    MARCACION {
        int id_marcacion PK
        int fk_bovino FK
        string codigo_arete "Areteo dia 7"
        date fecha_colocacion
        string estado_marca "Activa"
    }

    CONTROL_ORDENO {
        int id_ordeno PK
        int fk_bovino FK
        date fecha_ordeno
        decimal litros_am
        decimal litros_pm
